# Copy to .env and fill in. Never commit .env.

# Postgres connection string (Neon, Supabase, local, ...)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Key that encrypts the stored LinkedIn token. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy somewhere safe. Without it the stored token cannot be read.
ENCRYPTION_KEY=

# Only needed on your own computer, for `python auth.py`. Do NOT set these on the server.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# LinkedIn API version (YYYYMM). Change it if LinkedIn says the version is not active.
LINKEDIN_VERSION=202609

# CONNECTIONS = only your connections see the post (good for first tests). PUBLIC = everyone.
POST_VISIBILITY=CONNECTIONS

# 1 = nothing is sent to LinkedIn (posting and deleting are skipped). Use it while testing.
DRY_RUN=1

# URL of the public pages app (pages/, for example on Vercel). Leave empty to let the MCP server
# serve /upload and /approve itself (works when your host has no login in front of every URL).
PAGES_URL=

# Optional built-in Google login, for hosts that do not provide their own authentication.
# BASE_URL must be the public https URL of this server. Not needed on Prefect Horizon.
BASE_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_EMAIL=
